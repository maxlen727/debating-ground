{
  "name": "debating-ground",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "思辨场：通过和 AI 讨论、追问、辩论，把一个概念真正弄懂，并把理解落盘、定期回顾。",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/server.ts",
    "build": "tsc -p . && vite build",
    "start": "node server/server.ts",
    "check": "tsc -p .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4"
  }
}
