{
  "name": "debating-ground",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "思辨场：通过和 AI 讨论、追问、辩论，把一个概念真正弄懂，并把理解落盘、定期回顾。",
  "packageManager": "npm@11.21.1",
  "engines": {
    "node": ">=22.18",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/server.ts",
    "server:lan": "node server/server.ts --lan",
    "build": "tsc -p . && vite build",
    "start": "node server/server.ts",
    "check": "tsc -p .",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,html,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css,html,json}\"",
    "test": "node --test \"tests/**/*.test.ts\"",
    "sync:worker": "node scripts/sync-worker.ts",
    "fixtures:native": "node scripts/native-fixtures.ts",
    "bundle:native": "node scripts/bundle-native-ai.ts",
    "eval:prompts": "node scripts/eval-prompts.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitepress": "^1.6.4"
  },
  "allowScripts": {
    "esbuild": true
  }
}
